# ============================================
# LogiFlow — Variables d'environnement
# Copie ce fichier en `.env` et remplace les valeurs.
# ============================================

# API
VITE_API_URL=https://api.logiflow.fr/v1
VITE_WS_URL=wss://api.logiflow.fr/live

# Auth
VITE_AUTH_DOMAIN=logiflow.eu.auth0.com
VITE_AUTH_CLIENT_ID=your_client_id

# Carte
VITE_MAPBOX_TOKEN=pk.your_mapbox_token

# Notifications
VITE_FIREBASE_API_KEY=your_firebase_key
VITE_FIREBASE_PROJECT_ID=logiflow-prod

# Paiements
VITE_STRIPE_PUBLIC_KEY=pk_live_your_key

# Environnement
NODE_ENV=production
